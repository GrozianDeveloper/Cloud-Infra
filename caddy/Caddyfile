# --- Netbird (SPA + gRPC/api/relay) ---
{$NETBIRD_DOMAIN} {
	import cloud_secured
	@grpc protocol grpc
	handle @grpc {
		reverse_proxy h2c://{$NETBIRD_MGMT_UPSTREAM} {
			flush_interval -1
		}
	}
	# Embedded Dex + HTTP API live on management (not the SPA)
	handle /oauth2* {
		reverse_proxy {$NETBIRD_MGMT_UPSTREAM} {
			header_up Host {host}
			flush_interval -1
		}
	}
	handle /api/* {
		reverse_proxy h2c://{$NETBIRD_MGMT_UPSTREAM} {
			flush_interval -1
		}
	}
	handle /relay* {
		reverse_proxy h2c://{$NETBIRD_MGMT_UPSTREAM} {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy {$NETBIRD_UPSTREAM} {
			header_up Host {host}
			flush_interval -1
		}
	}
	import access_log_file /var/log/caddy/netbird-access.log
}

